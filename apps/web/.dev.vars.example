# 复制为 .dev.vars（本地）；线上在 Cloudflare 后台 Settings → Variables and Secrets 设置同名项
APP_URL=http://localhost:3000
# 登录会话签名密钥：openssl rand -base64 32
BETTER_AUTH_SECRET=
# 模型密钥加密主密钥（32 字节 base64）：openssl rand -base64 32
KEY_ENCRYPTION_SECRET=
# Google 登录（可选，不填则不显示 Google 按钮）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 验证码邮件的发件人（线上走 Cloudflare Email Service）。本地不填，验证码打印在终端
MAIL_FROM=
