{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plinth",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": false,
  // 页面由静态资源层直接返回（SPA 外壳），只有 /api/* 进 Worker，省 CPU
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "plinth", "database_id": "026f7b9e-dea9-49d1-b023-f2082b51e44d", "migrations_dir": "migrations" }
  ],
  // 验证码邮件：Cloudflare Email Service（Workers 付费版；发信域名要在 Email Service 接入）
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [
    { "name": "RL_AUTH", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_CHAT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_API", "namespace_id": "1003", "simple": { "limit": 300, "period": 60 } }
  ],
  // 密钥和网址等设置由 GitHub CI 用 wrangler secret bulk 同步（见 .github/workflows/deploy.yml）
  "keep_vars": true
}
