{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plinth",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // 页面由静态资源层直接返回（SPA 外壳），只有 /api/* 进 Worker，省 CPU
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "plinth", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "ratelimits": [
    { "name": "RL_AUTH", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_CHAT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_API", "namespace_id": "1003", "simple": { "limit": 300, "period": 60 } }
  ],
  "vars": { "APP_URL": "http://localhost:3000" }
}
