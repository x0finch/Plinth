  "name": "@plinth/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "auth:migration": "tsx scripts/auth-migration.ts",
    "db:migrate:local": "wrangler d1 migrations apply plinth --local",
    "db:migrate:remote": "wrangler d1 migrations apply plinth --remote",
    "deploy": "vite build && wrangler deploy",
    "deploy:ci": "wrangler d1 migrations apply plinth --remote && wrangler deploy",
    "fake-llm": "node e2e/fake-llm.mjs",
    "e2e": "node e2e/agent.e2e.mjs && node e2e/collab.e2e.mjs",
