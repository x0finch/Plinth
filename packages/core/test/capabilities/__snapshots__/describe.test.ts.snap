          "description": "ID of a look of the design that this becomes (e.g. after saving it to a library)",
          "type": "string",
        },
        "source": {
          "properties": {
            "library": {
              "type": "string",
            },
            "look": {
              "type": "string",
            },
            "version": {
              "anyOf": [
                {
                  "type": "string",
                },
                {
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer",
                },
              ],
            },
          },
          "required": [
            "library",
            "look",
            "version",
          ],
          "type": "object",
        },
        "types": {
          "additionalProperties": {
            "properties": {
              "group": {
                "type": "string",
              },
              "name": {
                "type": "string",
              },
              "size": {
                "properties": {
                  "d": {
                    "exclusiveMinimum": 0,
                    "type": "number",
                  },
                  "h": {
                    "exclusiveMinimum": 0,
                    "type": "number",
                  },
