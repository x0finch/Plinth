exports[`capability descriptions are stable 1`] = `
[
  {
    "description": "Project name, levels, gross area per level, object counts, brief and constraint overview. Call this before starting work.",
    "examples": [],
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {},
      "type": "object",
    },
    "kind": "query",
    "name": "project_summary",
    "permission": "read",
    "runtime": "any",
    "title": "Project overview",
  },
  {
    "description": "Search walls, spaces, openings, furniture and elements by name keyword, type and level. Returns ID, name, type and level.",
    "examples": [],
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "level": {
          "description": "Level ID or name",
          "type": "string",
        },
        "limit": {
          "default": 50,
          "maximum": 200,
          "minimum": 1,
          "type": "integer",
        },
        "query": {
          "description": "Name keyword in the language the project data uses, e.g. “Bedroom”, “north wall”, “Window” (or “老人房”, “北墙”, “窗”)",
          "type": "string",
        },
        "type": {
          "enum": [
            "wall",
            "space",
            "opening",
            "furniture",
            "element",
            "level",
            "constraint",
          ],
          "type": "string",
        },
      },
      "type": "object",
    },
    "kind": "query",
    "name": "find_objects",
    "permission": "read",
    "runtime": "any",
    "title": "Find objects",
  },
  {
    "description": "Get details of one object. Space: usable area, bounds, surrounding walls and their directions, neighboring spaces, furniture. Wall: endpoints, length, thickness, spaces on each side, openings. Opening: host wall, position, connected spaces.",
    "examples": [],
