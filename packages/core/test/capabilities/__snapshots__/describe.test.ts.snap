  {
    "description": "Add a new furniture type to the design (a fish tank, a mahjong table…), with its default size and, optionally, a recipe for its look (format in look_add). Then place it with furniture_add.",
    "examples": [],
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "group": {
          "description": "Group name shown in the catalog, in the project language",
          "type": "string",
        },
        "name": {
          "description": "Display name, in the language the project data uses",
          "minLength": 1,
          "type": "string",
        },
        "recipe": {
          "description": "A recipe: { params?, seed?, script, materials? } with a JSONata script (see the recipe format in look_add)",
        },
        "size": {
          "properties": {
            "d": {
              "exclusiveMinimum": 0,
              "type": "number",
            },
            "h": {
              "exclusiveMinimum": 0,
              "type": "number",
            },
            "w": {
              "exclusiveMinimum": 0,
              "type": "number",
            },
          },
          "required": [
            "w",
            "d",
            "h",
          ],
          "type": "object",
        },
        "type": {
          "description": "Type key, lowercase English (e.g. fish-tank)",
          "pattern": "^[a-z][a-z0-9-]*$",
          "type": "string",
        },
      },
      "required": [
        "type",
        "name",
        "size",
      ],
      "type": "object",
    },
    "kind": "edit",
    "name": "furniture_type_add",
    "permission": "reversible",
    "runtime": "any",
    "title": "Add a furniture type",
  },
