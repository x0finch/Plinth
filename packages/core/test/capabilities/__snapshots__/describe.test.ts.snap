  {
    "description": "Copy a look from a look library into the design (or bring a copied look up to the library's newer version). The design keeps its own copy, so everyone who opens it sees the same thing. Get the look with library_look_get.",
    "examples": [],
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "for": {
          "items": {
            "description": "What a look draws: 'furniture:<type>' (a furniture type), 'opening:<door|sliding-door|gate|window|opening|glass-block>', 'element:<stair|pond|drain>' or 'wall:railing'",
            "pattern": "^(furniture|opening|element|wall):[A-Za-z0-9_-]+$",
            "type": "string",
          },
          "minItems": 1,
          "type": "array",
        },
        "name": {
          "minLength": 1,
          "type": "string",
        },
        "recipe": {
          "description": "A recipe: { params?, seed?, script, materials? } with a JSONata script (see the recipe format in look_add)",
        },
