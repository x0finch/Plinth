            },
            "required": [
              "name",
              "size",
            ],
            "type": "object",
          },
          "description": "Furniture types the look draws that the design may not have yet",
          "propertyNames": {
            "type": "string",
          },
          "type": "object",
        },
        "use": {
          "default": false,
          "description": "Use it for every object of these targets",
          "type": "boolean",
        },
