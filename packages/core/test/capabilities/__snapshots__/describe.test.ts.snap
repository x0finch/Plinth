  },
  {
    "description": "Add a straight wall on the given level. Endpoints lie on the wall centreline.",
    "examples": [
      {
        "input": {
          "end": [
            3000,
            3600,
          ],
          "level": "L1",
          "start": [
            3000,
            120,
          ],
          "thickness": 120,
        },
        "note": "Add a north-south partition on level 1",
      },
    ],
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "end": {
          "description": "[x, y] in mm; x points east, y points south",
          "items": false,
          "maxItems": 2,
