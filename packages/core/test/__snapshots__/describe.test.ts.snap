// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`capability descriptions are stable 1`] = `
[
  {
    "description": "Project name, levels, gross area per level, object counts, brief and constraint overview. Call this before starting work.",
    "examples": [],
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {},
      "type": "object",
    },
    "kind": "query",
    "name": "project_summary",
    "permission": "read",
    "runtime": "any",
    "title": "Project overview",
  },
  {
    "description": "Search walls, spaces, openings, furniture and elements by name keyword, type and level. Returns ID, name, type and level.",
    "examples": [],
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "level": {
          "description": "Level ID or name",
          "type": "string",
        },
        "limit": {
          "default": 50,
          "maximum": 200,
          "minimum": 1,
          "type": "integer",
        },
        "query": {
          "description": "Name keyword in the language the project data uses, e.g. “Bedroom”, “north wall”, “Window” (or “老人房”, “北墙”, “窗”)",
          "type": "string",
        },
        "type": {
          "enum": [
            "wall",
            "space",
            "opening",
            "furniture",
            "element",
            "level",
            "constraint",
          ],
          "type": "string",
        },
      },
      "type": "object",
    },
    "kind": "query",
    "name": "find_objects",
    "permission": "read",
    "runtime": "any",
    "title": "Find objects",
  },
  {
    "description": "Get details of one object. Space: usable area, bounds, surrounding walls and their directions, neighboring spaces, furniture. Wall: endpoints, length, thickness, spaces on each side, openings. Opening: host wall, position, connected spaces.",
    "examples": [],
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "ref": {
          "description": "Object ID or name",
          "type": "string",
        },
      },
      "required": [
        "ref",
      ],
      "type": "object",
    },
    "kind": "query",
    "name": "get_object",
    "permission": "read",
    "runtime": "any",
    "title": "View object",
  },
  {
    "description": "Gross area per level and usable area per space (m²).",
    "examples": [],
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "level": {
          "type": "string",
        },
      },
      "type": "object",
    },
    "kind": "query",
    "name": "area_report",
    "permission": "read",
    "runtime": "any",
    "title": "Area report",
  },
  {
    "description": "Check for overlapping rooms, openings beyond the wall or overlapping, rooms without an entrance, bedrooms without a window, door leaves hitting furniture, furniture outside any space, and whether constraints are satisfied.",
    "examples": [],
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {},
      "type": "object",
    },
    "kind": "verify",
    "name": "check_rules",
    "permission": "read",
    "runtime": "any",
    "title": "Rule check",
  },
  {
    "description": "List all constraints and whether each is satisfied.",
    "examples": [],
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {},
      "type": "object",
    },
    "kind": "query",
    "name": "list_constraints",
    "permission": "read",
    "runtime": "any",
    "title": "Constraints",
  },
  {
    "description": "Add a straight wall on the given level. Endpoints lie on the wall centreline.",
    "examples": [
      {
        "input": {
          "end": [
            3000,
            3600,
          ],
          "level": "L1",
          "start": [
            3000,
            120,
          ],
          "thickness": 120,
        },
        "note": "Add a north-south partition on level 1",
      },
    ],
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "end": {
          "description": "[x, y] in mm; x points east, y points south",
          "items": false,
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number",
            },
            {
              "type": "number",
            },
          ],
          "type": "array",
        },
        "height": {
          "exclusiveMinimum": 0,
          "type": "number",
        },
        "kind": {
          "default": "partition",
          "enum": [
            "bearing",
            "partition",
            "fence",
            "parapet",
            "railing",
          ],
          "type": "string",
        },
        "level": {
          "description": "ID or name of the level (names may take a level prefix, e.g. “Level 2·Bedroom” or “二层·主卧”)",
          "type": "string",
        },
        "name": {
          "type": "string",
        },
        "start": {
          "description": "[x, y] in mm; x points east, y points south",
          "items": false,
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number",
            },
            {
              "type": "number",
            },
          ],
          "type": "array",
        },
        "thickness": {
          "description": "Wall thickness; defaults to 120 for partitions, 240 for bearing walls",
          "exclusiveMinimum": 0,
          "type": "number",
        },
      },
      "required": [
        "level",
        "start",
        "end",
      ],
      "type": "object",
    },
    "kind": "edit",
    "name": "wall_add",
    "permission": "reversible",
    "runtime": "any",
    "title": "Add wall",
  },
  {
    "description": "Translate a wall perpendicular to itself. Connected walls stretch to follow, the boundaries of spaces on both sides update, and openings keep their position on the wall.",
    "examples": [
      {
        "input": {
          "direction": "west",
          "distance": 500,
          "wall": "老人房一西墙",
        },
        "note": "Move 老人房一西墙 0.5 m west",
      },
    ],
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
